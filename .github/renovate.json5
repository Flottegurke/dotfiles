{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'helpers:pinGitHubActionDigests',
    'docker:pinDigests',
    ':configMigration',
    'abandonments:recommended',
  ],
  timezone: 'Europe/Berlin',
  schedule: [
    'at any time',
  ],
  prCreation: 'immediate',
  prConcurrentLimit: 20,
  prHourlyLimit: 20,
  prBodyColumns: [
    'Package',
    'Type',
    'Update',
    'Change',
    'Pending',
    'References',
  ],
  separateMultipleMajor: true,
  minimumReleaseAge: '3 days',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  automerge: false,
  configWarningReuseIssue: true,
  dependencyDashboard: {
    enabled: true,
  },
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
    automerge: false,
  },
  packageRules: [
    {
      groupName: 'GitHub Actions',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
    },
  ],
  assignees: [
    'flottegurke',
  ],
  labels: [
    'renovate',
  ],
}
